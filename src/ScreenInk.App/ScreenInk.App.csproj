<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>false</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\ScreenInk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenInk</AssemblyName>
    <RootNamespace>ScreenInk.App</RootNamespace>
    <Version>0.3.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenInk.Core\ScreenInk.Core.csproj" />
    <InternalsVisibleTo Include="ScreenInk.WindowsTests" />
    <Resource Include="Assets\ScreenInk.ico" Condition="Exists('Assets\ScreenInk.ico')" />
  </ItemGroup>
</Project>
